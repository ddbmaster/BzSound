<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- wichtig für CSS Plugins -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>

    <!-- 🔥 NEUER Plugin-Pfad -->
    <OutputPath>bin\Release\addons\counterstrikesharp\plugins\BzSound\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <DebugType>none</DebugType>

    <!-- optional aber sauber -->
    <AssemblyName>BzSound</AssemblyName>
    <RootNamespace>BzSound</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.380" />
  </ItemGroup>

</Project>